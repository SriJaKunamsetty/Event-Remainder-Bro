# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project Settings > Environment Variables.

# Server-only. Do NOT prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Model IDs are retired quickly. Check https://ai.google.dev/gemini-api/docs/deprecations
# before you deploy and update this value instead of changing code.
GEMINI_MODEL=gemini-3.5-flash
